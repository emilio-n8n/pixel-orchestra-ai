{
  "version": 1,
  "sdk_version": "0.22.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://krlmawwljhjwylvhscof.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "lilium-studio-mcp",
      "version": "0.1.0",
      "title": "Lilium Studio"
    },
    "tools": [
      {
        "name": "generate_image",
        "title": "Generate image",
        "description": "Generate an image from a text prompt into the given project.",
        "annotations": {
          "readOnlyHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "description": "Project id to attach the asset to."
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "project_id",
            "prompt"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "generate_voice",
        "title": "Generate voiceover",
        "description": "Generate a TTS voiceover (mp3) for the given text.",
        "annotations": {
          "readOnlyHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "voice": {
              "type": "string",
              "enum": [
                "alloy",
                "echo",
                "fable",
                "onyx",
                "nova",
                "shimmer"
              ]
            }
          },
          "required": [
            "project_id",
            "text"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "generate_voice_takes",
        "title": "Generate voice takes",
        "description": "Generate n (default 3) variations of the SAME line so the user can pick the best one. Takes share a take_group id; the Library/Inspector groups them for A/B.",
        "annotations": {
          "readOnlyHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "voice": {
              "type": "string",
              "enum": [
                "alloy",
                "echo",
                "fable",
                "onyx",
                "nova",
                "shimmer"
              ]
            },
            "n": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          "required": [
            "project_id",
            "text"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "generate_html_card",
        "title": "Generate HTML title card",
        "description": "Generate an ANIMATED HTML card (title, lower third, credits, transition) — ships with CSS keyframes (entrance + ambient motion) that become real video motion at export. Pass the text, vibe, colors and the motion in the brief.",
        "annotations": {
          "readOnlyHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string"
            },
            "brief": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "project_id",
            "brief"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_to_timeline",
        "title": "Add asset to timeline",
        "description": "Place an existing asset on a timeline track.",
        "annotations": {
          "readOnlyHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string"
            },
            "asset_id": {
              "type": "string"
            },
            "track": {
              "type": "string",
              "enum": [
                "Video",
                "Audio",
                "Music",
                "SFX",
                "Subtitles"
              ]
            },
            "start_ms": {
              "type": "integer"
            },
            "duration_ms": {
              "type": "integer"
            }
          },
          "required": [
            "project_id",
            "asset_id",
            "track"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "remove_from_timeline",
        "title": "Remove from timeline",
        "description": "Remove a clip from the timeline by its id. Pass ripple:true to also shift later clips on the same track left (closing the gap).",
        "annotations": {
          "readOnlyHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string"
            },
            "clip_id": {
              "type": "string"
            },
            "ripple": {
              "type": "boolean"
            }
          },
          "required": [
            "project_id",
            "clip_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "insert_silence_clip",
        "title": "Insert silence clip",
        "description": "Insert a native SILENCE clip on an audio track (Audio, Music, SFX). A pause with no asset — it occupies space so nothing plays during its duration. Use for pacing instead of computing start_ms gaps by hand.",
        "annotations": {
          "readOnlyHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string"
            },
            "duration_ms": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "track": {
              "type": "string",
              "enum": [
                "Audio",
                "Music",
                "SFX"
              ]
            },
            "start_ms": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "project_id",
            "duration_ms",
            "track"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "edit_subtitles",
        "title": "Edit subtitles",
        "description": "Edit a subtitle clip's text and/or style (font, size, color, position). The timeline renders subtitles from the clip meta.",
        "annotations": {
          "readOnlyHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string"
            },
            "clip_id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "style": {
              "type": "object",
              "properties": {
                "font": {
                  "type": "string"
                },
                "size": {
                  "type": "integer",
                  "minimum": 10,
                  "maximum": 120
                },
                "color": {
                  "type": "string"
                },
                "position": {
                  "type": "string",
                  "enum": [
                    "bottom",
                    "center",
                    "top"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "project_id",
            "clip_id",
            "text"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "apply_ducking",
        "title": "Apply ducking",
        "description": "Automatic ducking: while the source track (default Audio) plays, the target track (default Music) drops by attenuation_db with a smooth attack/release. Call once after placing voice + music.",
        "annotations": {
          "readOnlyHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string"
            },
            "source_track": {
              "type": "string",
              "enum": [
                "Audio",
                "Music",
                "SFX"
              ]
            },
            "target_track": {
              "type": "string",
              "enum": [
                "Audio",
                "Music",
                "SFX"
              ]
            },
            "attenuation_db": {
              "type": "number",
              "minimum": -40,
              "maximum": 0
            },
            "attack_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            },
            "release_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4000
            }
          },
          "required": [
            "project_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "set_clip_transitions",
        "title": "Crossfade clips",
        "description": "Crossfade two clips on the SAME track: clip B is pulled to overlap the tail of clip A by ms. Video → dissolve, audio → volume cross-fade.",
        "annotations": {
          "readOnlyHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string"
            },
            "clip_a_id": {
              "type": "string"
            },
            "clip_b_id": {
              "type": "string"
            },
            "ms": {
              "type": "integer",
              "minimum": 50,
              "maximum": 5000
            }
          },
          "required": [
            "project_id",
            "clip_a_id",
            "clip_b_id",
            "ms"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_timeline",
        "title": "List timeline clips",
        "description": "Read the current timeline for a project.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string"
            }
          },
          "required": [
            "project_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_assets",
        "title": "List assets",
        "description": "List recent assets in a project.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string"
            }
          },
          "required": [
            "project_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
